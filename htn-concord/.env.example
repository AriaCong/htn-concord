# Copy this file to `.env` (same directory) and fill in the values.
#
#     cp .env.example .env
#
# `.env` is gitignored (.gitignore line 53); this `.env.example` is explicitly
# un-ignored (line 55) so the variable NAMES are documented in the repo while
# the VALUES never are. Never put a real key in this file.
#
# scripts/run_pilot.py reads `.env` with a minimal loader that uses setdefault,
# so a variable already exported in your shell always wins over this file.

# ── Frontier arm (required) ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Optional. Defaults to gpt-6-astra. Set to a claude-* id to run the Anthropic
# arm instead, which also requires ANTHROPIC_API_KEY below.
# FRONTIER_MODEL=gpt-6-astra

# ── Open-weight arm (required for a GO verdict) ──────────────────────────────
# Without these the pilot has one arm, and K3 -- the question the pilot exists
# to answer -- cannot be evaluated. The driver refuses to run single-arm unless
# you pass --allow-single-arm.
# A key from whichever host you pick below -- NOT your OpenAI key.
# For Groq: console.groq.com -> API Keys. Keys look like gsk_...
OPENWEIGHT_API_KEY=gsk_REPLACE_ME

OPENWEIGHT_HOST=groq               # together | fireworks | groq | openrouter

# The EXACT version string, never a floating alias like "-latest": a floating
# alias changes what a "same" run ran without changing a line of code.
OPENWEIGHT_MODEL=openai/gpt-oss-120b

# Reasoning effort for this arm, pinned and recorded like the frontier arm's.
# gpt-oss accepts low | medium | high (no xhigh/max). Set it EMPTY for a
# non-reasoning model, whose host will reject the parameter.
OPENWEIGHT_EFFORT=high

# NOTE on this pairing: gpt-oss is OpenAI's open-weight model and the frontier
# arm is also OpenAI, so both arms share a lab. See the "same-lab" limitation
# recorded in docs/HTN-Concord_Pilot_Kill_Criteria.md -- it weakens the design's
# "a failure mode is a finding only if it replicates across models" bar, because
# a lab-level quirk would replicate across both and read as a finding.
# Different-lab alternatives, all with structured outputs, on Together:
#   deepseek-ai/DeepSeek-V4-Pro-0813   (carries a dated snapshot)
#   moonshotai/Kimi-K3
#   zai-org/GLM-5.3

# ── Optional: the retained Anthropic arm ─────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
