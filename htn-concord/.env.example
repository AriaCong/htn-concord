# Copy this file to `.env` (same directory) and fill in the values.
#
#     cp .env.example .env
#
# `.env` is gitignored (.gitignore line 53); this `.env.example` is explicitly
# un-ignored (line 55) so the variable NAMES are documented in the repo while
# the VALUES never are. Never put a real key in this file.
#
# scripts/run_pilot.py reads `.env` with a minimal loader that uses setdefault,
# so a variable already exported in your shell always wins over this file.

# ── Frontier arm (required) ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Optional. Defaults to gpt-6-astra. Set to a claude-* id to run the Anthropic
# arm instead, which also requires ANTHROPIC_API_KEY below.
# FRONTIER_MODEL=gpt-6-astra

# ── Open-weight arm (required for a GO verdict) ──────────────────────────────
# Without these the pilot has one arm, and K3 -- the question the pilot exists
# to answer -- cannot be evaluated. The driver refuses to run single-arm unless
# you pass --allow-single-arm.
OPENWEIGHT_API_KEY=REPLACE_ME
OPENWEIGHT_HOST=together           # together | fireworks | groq | openrouter

# The EXACT version string, never a floating alias like "-latest": a floating
# alias changes what a "same" run ran without changing a line of code.
OPENWEIGHT_MODEL=REPLACE_ME

# ── Optional: the retained Anthropic arm ─────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
