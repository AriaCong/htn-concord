{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://htn-concord/schemas/patient_profile.schema.json",
  "title": "PatientProfile",
  "description": "Canonical, source-agnostic patient row consumed by the Deterministic Guideline Engine. Every data source (NHANES, MIMIC-IV, eICU) must emit rows valid against this schema. Null is allowed wherever a value is genuinely unknown so the engine can ABSTAIN; it must never be coerced to a definite value.",
  "type": "object",
  "additionalProperties": true,
  "required": ["source", "age", "sex", "sbp", "dbp", "bp_stage", "bp_context", "med_classes", "contraindications"],
  "properties": {
    "source": {"type": "string", "enum": ["nhanes", "mimic_iv", "eicu", "synthetic"]},
    "age": {"type": ["number", "null"], "minimum": 0, "maximum": 120},
    "sex": {"type": ["string", "null"], "enum": ["male", "female", null]},
    "race_eth": {"type": ["number", "string", "null"], "description": "subgroup reporting only; engine is race-neutral"},
    "sbp": {"type": ["number", "null"], "minimum": 60, "maximum": 290},
    "dbp": {"type": ["number", "null"], "minimum": 30, "maximum": 200},
    "bp_stage": {"type": ["string", "null"], "enum": ["normal", "elevated", "stage1", "stage2", null]},
    "bp_context": {"type": "string", "enum": ["chronic", "office", "admission"], "description": "chronic/office BP drives staging; admission (ED/ICU) BP -> engine abstains on chronic staging"},
    "bp_n_readings": {"type": ["number", "null"], "minimum": 0},
    "creatinine": {"type": ["number", "null"], "minimum": 0.1, "maximum": 20, "description": "mg/dL"},
    "egfr": {"type": ["number", "null"], "description": "CKD-EPI 2021 race-free, mL/min/1.73m^2"},
    "potassium": {"type": ["number", "null"], "minimum": 1.5, "maximum": 9, "description": "mmol/L"},
    "uacr": {"type": ["number", "null"], "minimum": 0, "description": "urine albumin-creatinine ratio, mg/g"},
    "ckd_albuminuria": {"type": ["boolean", "null"]},
    "diabetes": {"type": ["boolean", "null"]},
    "clinical_cvd": {"type": ["boolean", "null"], "description": "established atherosclerotic CVD; high-risk trigger for Stage-1 initiation. NHANES emits null."},
    "hba1c": {"type": ["number", "null"], "description": "%"},
    "total_chol": {"type": ["number", "null"], "description": "mg/dL"},
    "hdl": {"type": ["number", "null"], "description": "mg/dL"},
    "bmi": {"type": ["number", "null"], "description": "kg/m^2"},
    "current_smoker": {"type": ["boolean", "null"]},
    "told_hypertension": {"type": ["boolean", "null"]},
    "on_bp_meds": {"type": ["boolean", "null"]},
    "statin_use": {"type": ["boolean", "null"], "description": "PREVENT input"},
    "med_classes": {"type": "array", "items": {"type": "string", "enum": ["thiazide", "acei", "arb", "dhp_ccb", "nondhp_ccb", "beta_blocker", "loop_diuretic", "mra", "alpha_blocker"]}},
    "prevent_10yr": {"type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "PREVENT 10-yr total-CVD risk %; null when not computable (age<30/>79 or missing inputs) -> engine ABSTAINS on Stage-1 risk trigger"},
    "contraindications": {"type": "array", "items": {"type": "string", "enum": ["pregnancy", "angioedema_hx", "hyperkalemia"]}}
  }
}
